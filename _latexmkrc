$lualatex = 'lualatex --file-line-error --halt-on-error --synctex=1 %O %S';

#------------------------------------------------------------------------------#
# compilation

# Build with LuaLaTeX; latexmk schedules only the required follow-up runs.
$pdf_mode = 4;
$aux_dir = 'build';
$out_dir = '.';
@default_files = ('main-german.tex');
$ENV{'TEXINPUTS'} = './tex//' . ($^O eq 'MSWin32' ? ';' : ':') . ($ENV{'TEXINPUTS'} // '');

# MiKTeX can wrap the fatal-error marker that LaTeX Workshop needs before
# parsing diagnostics. Repeat the existing marker on one complete line.
add_hook('after_xlatex', sub {
  open my $diagnostic_log, '<', $log_name or return;
  local $/;
  my $diagnostic_text = <$diagnostic_log>;
  close $diagnostic_log;
  my $fatal_marker = 'Fatal error occurred, no output PDF file produced!';
  return if index($diagnostic_text, $fatal_marker) >= 0;
  $diagnostic_text =~ s/\r?\n//g;
  print "\n$fatal_marker\n" if index($diagnostic_text, $fatal_marker) >= 0;
});

